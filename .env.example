# FinScope AI — environment variables
# Copy this file to .env and fill in your values.

# Groq API (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# HuggingFace token — used for embeddings and reranking via Inference API
HF_TOKEN=your_hf_token_here

# Embedding model (sentence-transformers identifier)
EMBED_MODEL=all-MiniLM-L6-v2

# Reranker model (HuggingFace cross-encoder identifier)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Retrieval parameters
TOP_K_RETRIEVE=20
TOP_K_RERANK=5

# Evaluation threshold
LLM_MODEL=llama-3.3-70b-versatile
FAITHFULNESS_THRESHOLD=0.80

# Paths (relative to project root)
DATA_DIR=data/
INDEX_DIR=indexes/

# Chunking parameters
CHUNK_SIZE=512
CHUNK_OVERLAP=64
